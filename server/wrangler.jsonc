// One worker for now: `tridge-scan-api-test` (`wrangler deploy`). It serves both
// Xcode-dev builds and TestFlight — App Attest with `APP_ATTEST_ALLOW_DEV=true`,
// plus a static bearer token for the local smoke harness. `store:true` and every
// other behavior here is already the production posture, so adding a dedicated
// prod worker later is purely additive — see server/README.md → "Adding a
// production worker later" (add an `env.prod` block, its own KV + OpenAI key,
// set APP_ATTEST_ALLOW_DEV=false, and switch ScanAPIConfig to a build-config URL).
//
// Secrets (never here; set with `wrangler secret put`):
//   OPENAI_API_KEY  — dedicated OpenAI project key with a budget cap
//   APPLE_TEAM_ID   — Apple Developer team id for com.tridge.app (App Attest)
//   SCAN_API_TOKEN  — app bearer token for the smoke harness (openssl rand -base64 32)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tridge-scan-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APPLE_BUNDLE_ID": "com.tridge.app",
    // Accept development-environment attestations (Xcode-signed dev builds on a
    // real device) in addition to production (TestFlight/App Store). A dedicated
    // prod worker later sets this "false" to accept production attestations only.
    "APP_ATTEST_ALLOW_DEV": "true",
    "DEVICE_DAILY_QUOTA": "50"
  },
  // Per-device App Attest registry (public key + sign counter) and per-device
  // quota counters. Created with `wrangler kv namespace create DEVICE_KV`; the
  // id is account-scoped and non-secret, so it lives in config.
  "kv_namespaces": [
    { "binding": "DEVICE_KV", "id": "3b653b7cf9684f4486c6cfa2c3aba208" }
  ],
  // 3 requests/min per client IP, across every route (scan + attest). Enough
  // for a human scanning receipts — note a brand-new install spends 3 on its
  // first scan (challenge + attest + scan), then 1 per scan after. Counted per
  // Cloudflare location (eventually consistent).
  "ratelimits": [
    {
      "name": "SCAN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
