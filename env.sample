# Copy to `.env` (gitignored) and fill in your own values.
# Used by the live receipt smoke tests:
#   swift test --filter ReceiptScanSmokeTests
# Secrets never go in the repo, CI, or build config (see AGENTS.md).

# Bearer token for the scan-API worker — the same value as its SCAN_API_TOKEN
# secret (`wrangler secret list` to confirm it's set). No token → the smoke
# test skips.
SCAN_API_TOKEN=your-scan-api-token

# Optional: point the smoke test at a different worker (defaults to the test
# environment, https://tridge-scan-api-test.forrestzjb.workers.dev).
# BACKEND_URL=https://tridge-scan-api-test.forrestzjb.workers.dev
